+#if defined(LLAMA_TN_GOVERNED)
+server_tn_model_result server_routes::run_tn_turn(
+        const std::string & rust_request_json,
+        const std::shared_ptr<server_tn_turn> & turn,
+        const std::function<bool()> & should_stop) {
+    server_response_reader reader(queue_tasks, queue_results, HTTP_POLLING_SECONDS);
+    queue_tasks.wait_until_no_sleep();
+
+    json body = json::parse(rust_request_json);
+    std::vector<raw_buffer> files;
+    json parsed = oaicompat_chat_params_parse(body, meta->chat_params, files);
+    if (!files.empty()) {
+        throw std::invalid_argument("TN model turn cannot contain files");
+    }
+    if (!parsed.at("prompt").is_string()) {
+        throw std::invalid_argument("TN model turn did not render one text prompt");
+    }
+    const std::string rendered_prompt = parsed.at("prompt").get<std::string>();
+    std::vector<server_tokens> inputs = tokenize_input_prompts(
+            ctx_server.vocab, ctx_server.mctx, parsed.at("prompt"), true, true);
+    if (inputs.size() != 1 || inputs.front().size() == 0 || inputs.front().has_mtmd) {
+        throw std::invalid_argument("TN model turn did not tokenize to one nonempty text input");
+    }
+
+    json delimiters_json = json_value(parsed, "message_delimiters", json::array());
+    auto delimiters = common_chat_msg_delimiters_parse(delimiters_json);
+    delimiters.tokenize(ctx_server.vocab);
+
+    server_task task(SERVER_TASK_TYPE_COMPLETION);
+    task.id = reader.get_new_id();
+    task.tokens = std::move(inputs.front());
+    task.params = server_schema::eval_llama_cmpl_schema(
+            ctx_server.vocab,
+            params,
+            meta->logit_bias_eog,
+            parsed);
+    task.params.message_spans = task.tokens.find_message_spans(delimiters);
+    task.params.res_type = TASK_RESPONSE_TYPE_OAI_CHAT;
+    task.params.oaicompat_cmpl_id = gen_chatcmplid();
+    task.params.oaicompat_model = meta->model_name;
+    task.tn_turn = turn;
+    task.tn_request_json = rust_request_json;
+    task.tn_rendered_prompt = rendered_prompt;
+    task.tn_runnable_manifest = server_tn_runnable_manifest(task, params.ctx_shift);
+
+    std::string tn_error;
+    if (!server_tn_prepare_model_turn(
+                *task.tn_turn,
+                task.tn_request_json,
+                task.tn_rendered_prompt,
+                task.tn_runnable_manifest,
+                tn_error)) {
+        throw std::runtime_error("TN turn preparation failed: " + tn_error);
+    }
+
+    reader.post_task(std::move(task));
+    server_task_result_ptr result = reader.next(should_stop);
+    if (!result) {
+        throw std::runtime_error("TN model turn was cancelled");
+    }
+    if (result->is_error()) {
+        auto * error = dynamic_cast<server_task_result_error *>(result.get());
+        throw std::runtime_error(
+                error != nullptr ? error->err_msg : "TN model turn failed without an error result");
+    }
+    auto * final = dynamic_cast<server_task_result_cmpl_final *>(result.get());
+    if (final == nullptr || !final->is_updated) {
+        throw std::runtime_error("TN model turn did not return an updated native final result");
+    }
+
+    return {
+        final->id,
+        final->id_slot,
+        final->truncated,
+        final->stop == STOP_TYPE_LIMIT,
+        final->content,
+        final->oaicompat_msg,
+    };
+}
