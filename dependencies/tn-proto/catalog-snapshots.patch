+
+#[test]
+fn catalog_snapshots_keep_independent_membership_and_exact_selections() {
+    let fixture = Fixture::new();
+    let (dag, revision, _) = history(&fixture);
+    let source = fixture.source(fixture.policy(&dag, &revision));
+    let first = fixture.edition("first", &source, &[revision.clone()]);
+    let second = fixture.edition("second", &source, &[revision.clone()]);
+    let third = fixture.edition("third", &source, &[revision]);
+    let mut catalog = DatasetCatalog::new();
+    catalog.admit(first.clone(), &dag, |_| Ok(true)).unwrap();
+    let selection = catalog.select("market.prices", "first", first.id(), &approved_use()).unwrap();
+    let mut snapshot = catalog.clone();
+
+    snapshot.admit(second.clone(), &dag, |_| Ok(true)).unwrap();
+    assert!(catalog.get(second.id()).is_none());
+    catalog.admit(third.clone(), &dag, |_| Ok(true)).unwrap();
+    assert!(snapshot.get(third.id()).is_none());
+    assert_eq!(catalog.len(), 2);
+    assert_eq!(snapshot.len(), 2);
+
+    let calls = AtomicUsize::new(0);
+    assert!(catalog.admit(second.clone(), &dag, |_| {
+        calls.fetch_add(1, Ordering::SeqCst);
+        Ok(false)
+    }).is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(catalog.get(second.id()).is_none());
+    assert_eq!(snapshot.get(second.id()).unwrap().object().wire(), second.object().wire());
+    assert!(snapshot.verify_binding(&selection.binding(), &PolicyDag::new()).is_err());
+    catalog.verify_binding(&selection.binding(), &dag).unwrap();
+    snapshot.verify_binding(&selection.binding(), &dag).unwrap();
+    drop(catalog);
+    drop(snapshot);
+    assert_eq!(selection.record().object().wire(), first.object().wire());
+    assert_eq!(selection.source_object_id(), source.id());
+    fixture.assert_refused_before_business(&source, &selection, &later_use(), &["finance"]);
+}
