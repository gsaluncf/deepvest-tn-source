+def test_catalog_rejects_authority_decision_when_another_thread_changes_membership(workflow):
+    from concurrent.futures import ThreadPoolExecutor
+
+    _, dag, _, entries = workflow
+    old, new = entries[0][2], entries[1][2]
+    catalog = g.DatasetCatalog()
+
+    def authorize(_):
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            executor.submit(catalog.admit, new, dag, lambda _: True).result(timeout=10)
+        return True
+
+    with pytest.raises(RuntimeError, match="changed during"):
+        catalog.admit(old, dag, authorize)
+    assert len(catalog) == 1
+    assert catalog.get(old.id) is None
+    assert catalog.get(new.id).object.wire == new.object.wire
+    catalog.admit(old, dag, lambda _: True)
+    assert len(catalog) == 2
